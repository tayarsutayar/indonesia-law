# ==============================================================================
# Indonesia Law — Environment Variables Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your actual credentials in '.env'.
# 3. NEVER commit '.env' to version control or share real API keys with LLMs/agents.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core & API Gateway (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME="Indonesia Law"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Static Bearer Token for API and WebSocket authorization (v1.0 spec: 06-api-and-realtime.md)
# Generate a strong token: openssl rand -hex 32
APP_STATIC_TOKEN=change-me-to-a-secure-random-token

# CORS Allowed Origins (comma-separated, required for React frontend dev and preview)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# Frontend Client (React + Vite, see: 02-architecture.md & 07-web-apps.md)
# ------------------------------------------------------------------------------
# Variables prefixed with VITE_ are embedded into the client build
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/events
# Development/testing token for frontend auth header injection
VITE_APP_STATIC_TOKEN=change-me-to-a-secure-random-token

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16 with pgvector, pg_trgm, btree_gist)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=indonesia_law
POSTGRES_USER=indonesia_law_user
POSTGRES_PASSWORD=your_strong_postgres_password_here

# SQLAlchemy Async Connection URL
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# Redis & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Explicit Celery Broker and Backend URLs
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ------------------------------------------------------------------------------
# MinIO Object Storage (Buckets: raw, pages, snapshots, llm-logs)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_strong_minio_password_here
MINIO_SECURE=false

# Bucket Names (defined in architecture spec: 02-architecture.md)
MINIO_BUCKET_RAW=indonesia-law-raw
MINIO_BUCKET_PAGES=indonesia-law-pages
MINIO_BUCKET_SNAPSHOTS=indonesia-law-snapshots
MINIO_BUCKET_LLM_LOGS=indonesia-law-llm-logs

# ------------------------------------------------------------------------------
# Azure OpenAI (LLM Gateway & Dynamic Skill Bank Embeddings)
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Primary Chat/Reasoning Model Deployment (e.g. gpt-4o, gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Vector Embedding Model Deployment for Dynamic Skill Bank (vector(1536), see: 03-data-model.md §2.11)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Token and Budget Rate Limits (05-prompts-and-llm.md)
LLM_BUDGET_USD_PER_DAY=50.00
LLM_TPM_LIMIT=120000
LLM_RPM_LIMIT=720

# Exchange rate for token cost display in dashboard and control wizard (USD to IDR)
USD_TO_IDR_RATE=16000

# ------------------------------------------------------------------------------
# Open-Web Search & Search Hunter (02-architecture.md §4 & 04-agents-and-pipeline.md)
# ------------------------------------------------------------------------------
# SearXNG instance endpoint (Docker compose profile 'observability' or external)
SEARXNG_URL=http://searxng:8080

# Optional external search engine API key (if using commercial search API fallback)
SEARCH_API_KEY=

# ------------------------------------------------------------------------------
# Polite Scraper Settings (02-architecture.md §6 & F2-discovery-and-scraping.md)
# ------------------------------------------------------------------------------
# Scraper User-Agent format: IndonesiaLawBot/1.0 (+<contact-url>; <contact-email>)
SCRAPER_CONTACT_URL=https://indonesia-law.id/bot
SCRAPER_CONTACT_EMAIL=bot@indonesia-law.id
SCRAPE_USER_AGENT="IndonesiaLawBot/1.0 (+${SCRAPER_CONTACT_URL}; ${SCRAPER_CONTACT_EMAIL})"
SCRAPE_MIN_DELAY_SEC=5
SCRAPE_JITTER_PCT=30
SCRAPE_PER_DOMAIN_CONCURRENCY=1

# Optional Crawl Window Restriction (e.g. night hours WIB to avoid daytime load)
SCRAPE_CRAWL_WINDOW_ENABLED=false
SCRAPE_CRAWL_WINDOW_START_WIB=22:00
SCRAPE_CRAWL_WINDOW_END_WIB=06:00

# ------------------------------------------------------------------------------
# Headless Browser Worker / Display QC (Playwright, see: Decision D6 in 12-risks-and-decisions.md)
# ------------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true

# ------------------------------------------------------------------------------
# Observability & Tracing (Optional Docker Compose Profile: 'observability')
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Langfuse Tracing (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ------------------------------------------------------------------------------
# System Alerts & External Notifications (09-observability-and-operations.md §3)
# ------------------------------------------------------------------------------
# Webhook URL for budget thresholds (80%/100%), blocked domains, and worker heartbeats
ALERT_WEBHOOK_URL=
