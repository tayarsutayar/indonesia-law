# ==============================================================================
# Indonesia Law — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (CRITICAL - Never commit credentials or keys)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# API keys, tokens, certificates, and credentials
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.der
id_rsa
id_rsa*
id_ed25519
id_ed25519*
*.pub
!scripts/**/*.pub
secrets/
*.secret
*.token
*bearer*
credentials.json
auth.json
service-account*.json
client_secrets*.json
jwt_secret*

# ------------------------------------------------------------------------------
# 2. AI Agents, Vibe Coding, & Local Assistant Scratchpads
# ------------------------------------------------------------------------------
.gemini/
.claude/
.cursor/
.cursorrules.local
.continue/
.copilot/
scratch/
brain/
*transcript*.jsonl
*.chat
*.prompt.dev

# ------------------------------------------------------------------------------
